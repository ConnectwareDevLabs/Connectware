{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connectware",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "contactus@connectware.in"
    }
  ]
}
